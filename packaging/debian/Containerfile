# Build environment for the Debian package (see build-deb.sh). Debian 13
# (trixie) and newer: on GTK 4.18 / libadwaita 1.7 the app builds without its
# `gnome49` feature (make-deb.sh decides). Rust comes from rustup, because
# Debian 13's own Rust is older than the app needs.
ARG DEBIAN_RELEASE=trixie
FROM docker.io/library/debian:${DEBIAN_RELEASE}-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        rustup pkg-config build-essential dpkg-dev ca-certificates \
        libgtk-4-dev libadwaita-1-dev libvirt-dev libosinfo-1.0-dev \
        libspice-client-glib-2.0-dev libgvnc-1.0-dev libvte-2.91-gtk4-dev \
        desktop-file-utils appstream \
    && rm -rf /var/lib/apt/lists/*
# The toolchain lives in the image; Cargo's download cache in a podman
# volume (/cargo), never in the home directory.
ENV RUSTUP_HOME=/rustup CARGO_HOME=/cargo
RUN rustup toolchain install stable --profile minimal && rustup default stable
